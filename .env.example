# Copie este arquivo para .env e ajuste se quiser.
# Nenhuma chave de API é obrigatória: preços vêm do Yahoo Finance (yfinance)
# e notícias vêm de feeds RSS públicos.

# Caminho do banco DuckDB (padrão: dados/newsmarket.duckdb)
NEWSMARKET_DB=dados/newsmarket.duckdb

# Arquivo com a lista de ativos e termos de busca (padrão: ativos.toml)
NEWSMARKET_ATIVOS=ativos.toml
